[Unit]
Description=Raspberry Pi 5 Smart Cylinder Collector
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=mother
Group=mother
WorkingDirectory=/opt/smart-cylinder-pi5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/smart-cylinder-pi5/.env
ExecStart=/opt/smart-cylinder-pi5/venv/bin/python /opt/smart-cylinder-pi5/main.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
